[Unit]
Description=AgentConduit outbound multi-PC Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/absolute/path/to/agentconduit-node serve --config %h/.config/agentconduit-node/config.json
Restart=on-failure
RestartSec=3s
TimeoutStopSec=25s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/agentconduit-node
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Add narrow ReadOnlyPaths entries if the selected service-manager policy does
# not already expose each configured allowed root read-only.

[Install]
WantedBy=default.target
