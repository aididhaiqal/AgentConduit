[Unit]
Description=AgentConduit local coding-agent coordination broker
After=network.target

[Service]
Type=simple
ExecStart=/absolute/path/to/agentconduit-mcp serve --config %h/.config/agentconduit/config.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=25s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/agentconduit
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
