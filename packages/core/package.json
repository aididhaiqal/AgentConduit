{
  "name": "@agentconduit/core",
  "version": "0.1.0",
  "description": "Persistence, Git discovery, messaging, and lease primitives for AgentConduit",
  "keywords": [
    "coding-agents",
    "coordination",
    "git",
    "sqlite",
    "worktrees"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aididhaiqal/AgentConduit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/aididhaiqal/AgentConduit#readme",
  "bugs": {
    "url": "https://github.com/aididhaiqal/AgentConduit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -p tsconfig.json --clean",
    "test": "vitest run",
    "type:check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
