# Development/compatibility flags only. The production workstation profile uses
# `agentconduit-mcp init` and a protected versioned config/token file instead.
# Never commit real credentials.
AGENTCONDUIT_DB=/absolute/path/to/agentconduit/coordination.db
AGENTCONDUIT_TOKEN=replace-with-a-high-entropy-local-token
AGENTCONDUIT_HOST=127.0.0.1
AGENTCONDUIT_PORT=8787
# Optional, delimiter-separated roots that the broker may inspect:
# AGENTCONDUIT_ALLOWED_ROOTS=/absolute/path/to/workspaces
